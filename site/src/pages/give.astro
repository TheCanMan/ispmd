---
/**
 * Give - DESIGN.md 14.7. Copy from COPY.md, "Give", verbatim.
 *
 * Section rhythm: shader masthead (dark, give) -> paper -> paper-warm ->
 * paper -> paper -> paper-cool -> ink footer. Two dark grounds total, footer
 * included, which is the maximum 4.2 allows.
 *
 * 13.3 - the give masthead's uLightOrigin.y scrubs from 0.02 to 0.5 across
 * the masthead's own scroll distance via onField(), the one interior page
 * with scrubbed shader motion. Skipped under prefers-reduced-motion.
 *
 * The suggested-amount tiles this section used to carry were cut - a voice
 * pass judged them a pitch. What is left is the fact, the EIN, and how to
 * give.
 */
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import Media from '../components/Media.astro';
import Button from '../components/Button.astro';

import { site } from '../data/site';
---

<Base
  title="Give - Islamic School of Potomac"
  description="Tuition is $60 a student. It does not cover a year. The Islamic School of Potomac is a 501(c)(3) non-profit, EIN 52-1989063."
>
  {/* 1. Masthead */}
  <Masthead preset="give" dark label="SUPPORT THE SCHOOL" lines={['A school with', '$60 tuition.']}>
    <p class="t-lead give-sub" data-motion="body-rise">
      Donations cover the rest.
    </p>
  </Masthead>

  {/* 2. Why */}
  <Section ground="paper" grid>
    <p class="t-lead why__lead" data-motion="body-rise">
      Tuition is $60 a student.
    </p>

    <div class="why__media">
      <Media slotId="give.impact" sizes="100vw" />
    </div>
  </Section>

  {/* 3. What $60 means here */}
  <Section ground="warm" grid>
    <div class="means__text">
      <SectionHeader
        label="WHERE THE MONEY GOES"
        headline="Donations pay for books, materials, and the year's milestones."
        role="t-title"
      >
        <div class="flow">
          <p class="t-body" data-motion="body-rise">
            Money given to this school goes toward the books a class reads, the materials a
            teacher needs, the Deen Showcase in December, and the Quran Competition in May.
          </p>
        </div>
      </SectionHeader>
    </div>

    <Card class="means__card">
      <p class="t-num means__ein">
        The Islamic School of Potomac is a<br />501(c)(3) non-profit organization.<br />Donations are
        tax-deductible.
      </p>
      <p class="t-num means__ein-number">EIN 52-1989063</p>
    </Card>
  </Section>

  {/* 4. Give */}
  <Section ground="paper" grid>
    <div class="give__actions">
      <p class="t-small give__note" data-motion="body-rise">
        Any amount goes to the same place. Give once, or set up something monthly, with a card or
        a PayPal balance.
      </p>
      <Button href={site.donateUrl} variant="primary" external>Give through PayPal</Button>
    </div>
  </Section>

  {/* 5. By check */}
  <Section ground="paper" grid>
    <div class="check__text">
      <SectionHeader label="BY CHECK" headline="A check in the mail still works." role="t-title" />
      <p class="t-body" data-motion="body-rise">
        Make it out to the Islamic School of Potomac and send it to:
      </p>
    </div>

    <Card class="check__card">
      <p class="t-label">Mail only</p>
      <p class="t-num">
        Islamic School of Potomac<br />P.O. Box 833<br />Rockville, MD 20848-0833
      </p>
    </Card>
  </Section>

  {/* 6. Thank you */}
  <Section ground="cool">
    <div class="other">
      <SectionHeader
        label="THANK YOU"
        headline="Thank you for supporting the school."
        role="t-title"
      />
      <p class="t-body" data-motion="body-rise">
        Volunteering helps too. If you have an hour or a skill to offer, get in touch.
      </p>
      <div class="other__cta" data-motion="body-rise">
        <Button href="/contact" variant="quiet" icon="arrow-right">Get in touch</Button>
      </div>
    </div>
  </Section>
</Base>

<script>
  // DESIGN.md 13.3 - light rises through the give masthead as you read.
  import { onField } from '../scripts/webgl';
  import { ScrollTrigger, prefersReducedMotion } from '../scripts/motion';

  onField('give', (field) => {
    if (prefersReducedMotion()) return;
    ScrollTrigger.create({
      trigger: document.querySelector('.masthead'),
      start: 'top top',
      end: 'bottom top',
      scrub: 0.6,
      onUpdate: (self) => field.setUniform('uLightOrigin', [0.5, 0.02 + self.progress * 0.48]),
    });
  });
</script>

<style>
  /* ---- Masthead sub-line ---- */

  .give-sub {
    grid-column: 1 / -1;
    color: var(--text-on-dark-soft);
    margin-block-start: var(--s-4);
  }

  @media (min-width: 768px) {
    .give-sub { grid-column: 1 / 9; }
  }

  @media (min-width: 1024px) {
    .give-sub { grid-column: 1 / 8; }
  }

  /* ---- 2. Why ---- */

  .why__lead,
  .why__media {
    grid-column: 1 / -1;
  }

  .why__media {
    margin-block-start: var(--s-7);
  }

  @media (min-width: 768px) {
    .why__lead { grid-column: 1 / 9; }
  }

  @media (min-width: 1024px) {
    .why__lead { grid-column: 2 / 9; }
  }

  /* ---- 3. What $60 means here ---- */

  .means__text,
  :global(.means__card) {
    grid-column: 1 / -1;
  }

  :global(.means__card) {
    margin-block-start: var(--s-6);
  }

  .means__ein,
  .means__ein-number {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
  }

  .means__ein-number {
    margin-block-start: var(--s-4);
  }

  @media (min-width: 768px) {
    .means__text { grid-column: 1 / 7; }
    :global(.means__card) { grid-column: 7 / 11; margin-block-start: 0; }
  }

  @media (min-width: 1024px) {
    .means__text { grid-column: 2 / 7; }
    :global(.means__card) { grid-column: 7 / 11; }
  }

  /* ---- 4. Give ---- */

  .give__actions {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--s-4);
    margin-block-start: var(--s-8);
  }

  .give__note {
    max-width: var(--measure-lead);
  }

  /* ---- 5. By check ---- */

  .check__text,
  :global(.check__card) {
    grid-column: 1 / -1;
  }

  :global(.check__card) {
    margin-block-start: var(--s-6);
  }

  @media (min-width: 768px) {
    .check__text { grid-column: 1 / 7; }
    :global(.check__card) { grid-column: 2 / 7; margin-block-start: var(--s-7); }
  }

  @media (min-width: 1024px) {
    :global(.check__card) { grid-column: 2 / 7; }
  }

  /* ---- 6. Other ways ---- */

  .other {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    max-width: var(--measure);
  }

  .other__cta {
    margin-block-start: var(--s-2);
  }
</style>
