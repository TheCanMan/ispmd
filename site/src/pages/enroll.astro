---
/**
 * Enroll - DESIGN.md 14.5. Copy from COPY.md, Enroll, verbatim.
 *
 * The live JotForm is multi-step and long. JotForm's official embed handler
 * grows the iframe to each step's natural height, so enrollment stays in the
 * page's normal scroll rather than inside a nested scrolling porthole.
 */
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Media from '../components/Media.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import HairlineList from '../components/HairlineList.astro';
import HairlineRow from '../components/HairlineRow.astro';

import { labels, site } from '../data/site';

const jotformIframeId = `JotFormIFrame-${site.enrollFormId}`;
const jotformSelector = `iframe[id='${jotformIframeId}']`;
const jotformOrigin = `${new URL(site.enrollFormUrl).origin}/`;
---

<Base
  title="Enroll - Islamic School of Potomac"
  description="Tuition is $60 for one student and $100 for a family, and financial assistance is available. Here is how to enroll for 2026-2027."
>
  {/* 1. Masthead */}
  <Masthead
    preset="enroll"
    label="ENROLLMENT 2026 - 2027"
    lines={['Enroll your child.']}
  />

  {/* 2. What you are enrolling in */}
  <Section ground="paper" grid>
    <p class="t-lead enrolling__lead" data-motion="body-rise">
      One morning a week, from September through May. Arabic, Deen, and everything in between, for
      children ages 5 through 18. Class begins at 10:00 AM and runs until Salat al-Dhuhr, at the
      Islamic Education Center on Montrose Road in Potomac.
    </p>

    <Media
      slotId="enroll.sunday"
      sizes="(min-width: 1024px) 90vw, 100vw"
      class="enrolling__media"
    />
  </Section>

  {/* 3. Tuition */}
  <Section ground="warm" grid>
    <p class="t-label tuition__label" data-motion="body-rise">TUITION</p>

    <div class="tuition__figure tuition__figure--student" data-motion="line-rise">
      <p class="tuition__amount t-num">$60</p>
      <p class="t-label">one student</p>
    </div>

    <div class="tuition__figure tuition__figure--family" data-motion="line-rise">
      <p class="tuition__amount t-num">$100</p>
      <p class="t-label">a family</p>
    </div>

    <Card class="tuition__assistance" as="aside">
      <div class="flow">
        <p class="t-body">Financial assistance is available.</p>
        <p class="t-body">
          It is not a special case and it is not a favor. If tuition is a difficulty for your
          family, say so when you enroll and it will be handled quietly. No child has ever been
          turned away from this school over $60.
        </p>
      </div>
    </Card>
  </Section>

  {/* 4. Who it is for */}
  <Section ground="paper" grid>
    <div class="enroll-list">
      <p class="t-label enroll-list__label" data-motion="body-rise">WHO IT'S FOR</p>
      <HairlineList>
        <HairlineRow title="Ages 5 through 18">
          <p class="t-body">
            Classes begin at kindergarten, with 5 year-olds, and run through high school.
          </p>
        </HairlineRow>
        <HairlineRow title="Arabic placement is by test">
          <p class="t-body">
            A short placement test before the year starts, so your child sits with others reading
            at the same level. Nobody passes or fails it.
          </p>
        </HairlineRow>
        <HairlineRow title="Deen placement is by age">
          <p class="t-body">Deen classes are grouped by the age of the student.</p>
        </HairlineRow>
      </HairlineList>
    </div>
  </Section>

  {/* 5. Steps */}
  <Section ground="paper" grid>
    <div class="enroll-steps">
      <p class="t-label enroll-list__label" data-motion="body-rise">HOW IT WORKS</p>
      <HairlineList>
        <HairlineRow marker="01" title="Fill in the form">
          <p class="t-body">It takes a few minutes. Your child, your family, and how to reach you.</p>
        </HairlineRow>
        <HairlineRow marker="02" title="The school writes back">
          <p class="t-body">
            You will hear from someone about Arabic placement and anything else that needs sorting
            before September.
          </p>
        </HairlineRow>
        <HairlineRow marker="03" title="Tuition">
          <p class="t-body">
            $60 for one student, $100 for a family. If that is a difficulty, say so in your reply.
          </p>
        </HairlineRow>
        <HairlineRow marker="04" title="The first Sunday">
          <p class="t-body">Back to School Day is September 13, 2026. Class begins at 10:00 AM.</p>
        </HairlineRow>
      </HairlineList>
    </div>
  </Section>

  {/* 6. The form. JotForm's handler owns the height across step changes. */}
  <Section ground="cool" container="narrow">
    <p class="t-label form__label" data-motion="body-rise">ENROLLMENT FORM</p>

    <div class="jotform-frame" data-motion="body-rise">
      <iframe
        id={jotformIframeId}
        class="jotform-frame__iframe"
        src={site.enrollFormUrl}
        title="ISP Registration 2026-27 - Step 1"
        loading="lazy"
        scrolling="no"
        allow="geolocation; microphone; camera; fullscreen; payment"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>

    <script is:inline src="https://cdn.jotfor.ms/s/umd/latest/for-form-embed-handler.js"></script>
    <script is:inline define:vars={{ jotformSelector, jotformOrigin }}>
      window.jotformEmbedHandler(jotformSelector, jotformOrigin);
    </script>

    <div class="jotform-fallback" data-motion="body-rise">
      <p class="t-small">Having trouble with the form?</p>
      <Button
        href={site.enrollFormUrl}
        variant="quiet"
        icon="external"
        external
      >
        {labels.jotformDirect}
      </Button>
    </div>
  </Section>

  {/* 7. Questions */}
  <Section ground="paper" container="narrow">
    <div class="questions">
      <SectionHeader headline="Questions before you enroll?" role="t-title" />
      <p class="t-body" data-motion="body-rise">
        Most of them are already answered on the FAQs page. If yours isn't, call
        <a class="link t-num" href={site.phone.href}>{site.phone.display}</a> or write to
        <a class="link t-num" href={site.email.href}>{site.email.display}</a> and a person will read
        it.
      </p>
      <div class="questions__links" data-motion="body-rise">
        <Button href="/faqs" variant="quiet" icon="arrow-right">Read the FAQs</Button>
        <Button href={site.email.href} variant="quiet" icon="mail">{site.email.display}</Button>
      </div>
    </div>
  </Section>
</Base>

<style>
  .enrolling__lead,
  :global(.enrolling__media),
  .tuition__label,
  .tuition__figure,
  :global(.tuition__assistance),
  .enroll-list,
  .enroll-steps {
    grid-column: 1 / -1;
  }

  :global(.enrolling__media) {
    margin-block-start: var(--s-8);
  }

  .tuition__label {
    margin-block-end: var(--s-6);
  }

  .tuition__figure {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding-block: var(--s-5);
  }

  .tuition__amount {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    color: var(--ctx-text);
  }

  :global(.tuition__assistance) {
    margin-block-start: var(--s-5);
  }

  .enroll-list,
  .enroll-steps {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  .enroll-list__label,
  .form__label {
    margin-block-end: var(--s-2);
  }

  .jotform-frame {
    width: 100%;
    max-width: var(--container-narrow);
    margin-block-start: var(--s-5);
    padding: var(--s-5);
    overflow: hidden;
    background: var(--paper);
    border: var(--border-hair) solid var(--rule-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .jotform-frame__iframe {
    display: block;
    width: 100%;
    max-width: 100%;
    min-height: var(--container-narrow);
    border: 0;
    background: var(--paper);
  }

  .jotform-fallback {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--s-2);
    margin-block-start: var(--s-4);
  }

  .questions {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  .questions__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-6);
  }

  @media (min-width: 1024px) {
    .enrolling__lead {
      grid-column: 2 / 8;
    }

    :global(.enrolling__media) {
      grid-column: 1 / 11;
    }

    .tuition__label {
      grid-column: 1 / 11;
    }

    .tuition__figure--student {
      grid-column: 2 / 5;
    }

    .tuition__figure--family {
      grid-column: 5 / 8;
    }

    :global(.tuition__assistance) {
      grid-column: 8 / 11;
      align-self: start;
      margin-block-start: 0;
    }

    .enroll-list {
      grid-column: 2 / 9;
    }

    .enroll-steps {
      grid-column: 2 / 8;
    }
  }

</style>
