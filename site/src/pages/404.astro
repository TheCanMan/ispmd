---
/**
 * DESIGN.md 14.9. Copy from COPY.md, verbatim.
 *
 * The numeral sits behind the text block in --fs-mega at 0.08 opacity,
 * clipped by the left container edge - the only use of --fs-mega on the site,
 * and one of exactly two places centred display type appears (17).
 */
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { labels } from '../data/site';
---

<Base
  title="Page not found - Islamic School of Potomac"
  description="That page is not here."
>
  <section class="notfound section-lg ground-paper">
    <div class="lattice lattice--quiet" aria-hidden="true"></div>

    <div class="container notfound__inner">
      <div class="notfound__block">
        <h1 class="t-display" data-motion="line-rise">That page isn't here.</h1>
        <p class="t-body" data-motion="body-rise">
          The pattern continues, though. One of these will get you where you were going.
        </p>

        <div class="notfound__links" data-motion="body-rise">
          <Button href="/" variant="quiet" icon="arrow-right">{labels.home404}</Button>
          <Button href="/program" variant="quiet" icon="arrow-right">{labels.program}</Button>
          <Button href="/calendar" variant="quiet" icon="arrow-right">{labels.calendar}</Button>
          <Button href="/contact" variant="quiet" icon="arrow-right">{labels.contact}</Button>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 70svh;
    display: flex;
    align-items: center;
  }

  .notfound__inner {
    position: relative;
    z-index: var(--z-content);
  }

  /*
   * 14.9 - the numeral sits behind the text block at 0.08 opacity, clipped by
   * the left container edge. It is the only use of --fs-mega on the site.
   *
   * It is CSS-generated content rather than an aria-hidden <p> because that is
   * what it actually is: decoration that carries no information. Generated
   * content never enters the accessibility tree at all, so there is no hidden
   * text node for a screen reader to reach or for a contrast rule to judge as
   * body copy - which is the honest answer, since WCAG 1.4.3 exempts
   * incidental text and this numeral says nothing the <h1> does not.
   */
  .notfound__inner::before {
    content: "404";
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: calc(var(--gutter) * -1);
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-size: var(--fs-mega);
    font-variation-settings: var(--vf-mega);
    line-height: var(--lh-mega);
    letter-spacing: var(--tr-mega);
    color: var(--text);
    opacity: 0.08;
    pointer-events: none;
    user-select: none;
    z-index: var(--z-base);
  }

  .notfound__block {
    position: relative;
    z-index: var(--z-content);
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    max-width: var(--measure);
  }

  @media (min-width: 1024px) {
    .notfound__block {
      margin-inline-start: 10%;
    }
  }

  .notfound__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5) var(--s-7);
    margin-block-start: var(--s-4);
  }
</style>
