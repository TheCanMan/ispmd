---
/**
 * DESIGN.md 14.1 section 1, 13.1 and 13.2.
 *
 * Full viewport, 100svh, min-height 640px. The type block sits OVER the
 * canvas, not inside it. `.hero-window` is an empty positioned box: it is the
 * aperture, and its rect is what drives the shader.
 *
 * Three tiers, applied independently of prefers-reduced-motion, which then
 * applies on top of whichever tier resolved:
 *
 *   1  the Three.js Field, real depth and a real interlace
 *   2  the same light field as a fullscreen quad, preset home-flat
 *   3  a layered CSS gradient plus the flat lattice. Static, and genuinely
 *      good-looking. Not an apology.
 */
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { labels, epigraph } from '../../data/site';
import { getSlot } from '../../data/media';

/* 13.2 - State A while the montage is a placeholder: no video element, no
   poster. The aperture is simply where the light comes through. */
const montage = getSlot('home.hero.montage');
const hasFootage = montage.status === 'real' && !!montage.src;
---

<section class="hero" data-hero data-motion-group>
  <div class="hero__fallback" aria-hidden="true">
    <div class="lattice lattice--present lattice--on-dark lattice--lg"></div>
  </div>

  <canvas class="hero__canvas" aria-hidden="true" tabindex="-1" data-hero-canvas></canvas>


  <div class="hero__inner container">
    {/*
      The epigraph the school already uses, 20:114. The client asked for it at
      the top of the page, with the header, so it opens the hero.

      It sits INSIDE .hero__inner deliberately. As a sibling of it, the type
      block's own scrim - inset 96px and blurred - painted straight over this
      text: measured 1.65:1 on the Arabic, effectively invisible. Sharing one
      parent puts both scrims in the same z-index -1 layer, beneath all of the
      text rather than on top of some of it.

      Quiet in SCALE, not in contrast. The Arabic is full --text-on-dark, stays
      Amiri, and keeps lang="ar" dir="rtl"; it is never letter-spaced (3).
    */}
    <div class="hero__epigraph on-dark">
      <p class="t-arabic hero__epigraph-ar" lang="ar" dir="rtl">{epigraph.arabic}</p>
      <p class="t-small t-italic hero__epigraph-en">{epigraph.english}</p>
      <p class="t-label hero__epigraph-ref">{epigraph.reference}</p>
    </div>

    <div class="hero__grid grid">
      <div class="hero__type on-dark">
        <p class="t-label" data-motion="body-rise">POTOMAC, MARYLAND · SUNDAY MORNINGS</p>

        <h1 class="t-hero hero__headline" data-motion="line-rise">
          We are more than <br />a Sunday school. <br />We are a community.
        </h1>

        <p class="t-lead measure-lead" data-motion="body-rise">
          A school for children ages 5 to 18, one morning a week, built by the families who send
          their children to it. New families are always welcome - come on any Sunday and see a
          class.
        </p>

        <div class="hero__actions" data-motion="body-rise">
          <Button href="/enroll" variant="primary">{labels.enrollPrimary}</Button>
          <Button href="/program" variant="quiet" icon="arrow-right">{labels.program}</Button>
        </div>
      </div>

      {/* The aperture. Empty by design: the lattice is culled inside it and
          the light comes through. */}
      <div class="hero-window hero__window" data-hero-window>
        {
          hasFootage && (
            <video muted loop playsinline preload="metadata" aria-hidden="true" class="hero__video" />
          )
        }
      </div>
    </div>
  </div>

  <div class="hero__cue on-dark" aria-hidden="true">
    <p class="t-label">Scroll</p>
    <svg class="hero__arrow" width="40" height="40" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="butt" stroke-linejoin="miter">
      <g transform="rotate(90 10 10)">
        <path data-cue-path d="M2,10 H17" />
        <path data-cue-path d="M13.1,5.5 L18,10 L13.1,14.5" />
      </g>
    </svg>
  </div>
</section>

<script>
  import { detectTier } from '../../scripts/webgl';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const windowEl = document.querySelector<HTMLElement>('[data-hero-window]');

  if (hero && canvas && windowEl) {
    const tier = detectTier();

    /* Tier 3 leaves the CSS gradient showing and stops here. Nothing on this
       page depends on the canvas, so there is nothing to apologise for. */
    if (tier !== 3) {
      const wide = window.innerWidth >= 900;

      if (tier === 1) {
        const { mountHeroField } = await import('../../scripts/hero-field');
        const field = await mountHeroField({
          canvas,
          windowEl,
          /* 13.2 - 4 rings at Tier 1 desktop, 2 below 900px. */
          rings: wide ? 4 : 2,
          onFallback: () => canvas.classList.remove('is-live'),
        });

        if (field) {
          const { gsap, ScrollTrigger, prefersReducedMotion } = await import('../../scripts/motion');

          /* Scrubbed handoff. Under reduced motion the pinned/scrubbed work
             is off entirely and the hero is one still frame. */
          if (!prefersReducedMotion()) {
            ScrollTrigger.create({
              trigger: hero,
              start: 'top top',
              end: 'bottom top',
              scrub: 0.6,
              onUpdate: (self) => field.setScrollProgress(self.progress),
            });

            /* The scroll cue draws on a 2.4s loop (14.1). */
            const cue = document.querySelectorAll<SVGPathElement>('[data-cue-path]');
            if (cue.length) {
              gsap.fromTo(
                cue,
                { drawSVG: '0%' },
                { drawSVG: '100%', duration: 1.2, ease: 'expo.out', repeat: -1, repeatDelay: 1.2 }
              );
            }
          }
        }
      } else {
        /* Tier 2: the same light field as a fullscreen quad, with the same
           aperture cut. ~5KB of shader instead of a scene graph. */
        const { mountField } = await import('../../scripts/webgl');
        const handle = await mountField(canvas, {
          preset: 'home-flat',
          onFallback: () => canvas.classList.remove('is-live'),
        });

        if (handle) {
          const push = () => {
            const canvasRect = canvas.getBoundingClientRect();
            const box = windowEl.getBoundingClientRect();
            if (!canvasRect.width || !canvasRect.height) return;
            handle.setWindowRect(
              (box.left - canvasRect.left) / canvasRect.width,
              1 - (box.bottom - canvasRect.top) / canvasRect.height,
              box.width / canvasRect.width,
              box.height / canvasRect.height
            );
          };
          push();
          window.addEventListener('resize', push, { passive: true });
          document.fonts?.ready.then(push);
        }
      }
    }
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    /*
     * min-height, not height. With a fixed height, content taller than the
     * viewport overflows a centred flex box in BOTH directions, so the type
     * block rode up under the fixed header and the eyebrow rendered on the
     * same line as the wordmark. Measured at 768: the block started at y=-13.
     * min-height keeps "full viewport" and lets a tall hero simply be taller.
     */
    min-height: max(640px, 100svh);
    overflow: hidden;
    /* The header is fixed and the hero sits under it, plus a little air so
       the eyebrow never sits flush against the header's bottom edge. */
    padding-block-start: calc(64px + var(--s-6));
    padding-block-end: var(--s-9);
  }

  @media (min-width: 1024px) {
    .hero {
      padding-block-start: calc(76px + var(--s-6));
    }
  }

  /**
   * Tier 3, and the ground every other tier paints over. It has to match the
   * shader's own palette or a no-WebGL visitor gets a different site: deep
   * pine, light coming through as terracotta rather than gold.
   */
  .hero__fallback {
    position: absolute;
    inset: 0;
    z-index: var(--z-base);
    background:
      radial-gradient(120% 90% at 68% 46%, var(--fill-apricot) 0%, transparent 46%),
      radial-gradient(140% 110% at 62% 52%, var(--slate) 0%, transparent 62%),
      linear-gradient(158deg, var(--slate-deep) 0%, var(--ink) 100%);
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    z-index: var(--z-media);
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .hero__canvas.is-live {
    opacity: 1;
  }

  /**
   * 14.1 promises that "the backdrop's dark end guarantees contrast at the
   * type's position". Measured, it does not: with uGlow at 1.0 the light term
   * in 13.3 never falls below about 0.2, so the field stays mid-tone and the
   * lattice ribbons are --paper on top of that. Sampling the true backdrop
   * with the text hidden, --text-on-dark landed as low as 1.00:1.
   *
   * The scrim is therefore anchored to the TYPE BLOCK, not to the viewport.
   * A viewport-anchored gradient has to be re-guessed at every breakpoint and
   * was wrong at all of them: at 1440 the headline ran off its right edge, and
   * below 1200 the block spans full width and the gradient never covered it.
   * Anchored to the element, it cannot miss.
   *
   * It resolves to solid --ink under the text, which is what makes 6.3's
   * verified pairings hold by construction rather than by luck, and falls off
   * over a long radius so it reads as the light running out rather than as a
   * panel. It is not the hero 12.4 refuses: no photograph, not centred, and
   * the geometry stays legible the whole way through.
   */
  .hero__type,
  .hero__cue {
    position: relative;
  }

  .hero__type::before,
  .hero__cue::before {
    content: "";
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }

  /*
   * A solid --ink rectangle inset to the block, feathered with a static blur.
   * A radial gradient has to be tuned so its falloff lands outside the text,
   * and it was wrong at three of seven breakpoints. Blurring a solid keeps
   * the core at FULL --ink over the whole block by construction and puts the
   * entire falloff outside it, which is the property that was missing.
   */
  .hero__type::before {
    inset: calc(var(--s-11) * -1);
    background: var(--ink);
    /* A big blur radius is what stops this reading as a panel. At --s-7 the
       rectangle's corners were still legible; at --s-9 the falloff is ~190px
       wide and the shape dissolves into the field. The inset is twice the
       radius so the whole feather lands outside the text. */
    filter: blur(var(--s-9));
  }

  .hero__cue::before {
    inset: calc(var(--s-9) * -1);
    background: var(--ink);
    filter: blur(var(--s-7));
  }

  .hero__epigraph {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-5);
    margin-block-end: var(--s-8);
    color: var(--text-on-dark-soft);
  }

  /* Same construction as the type block's scrim: a solid --ink rectangle
     inset to twice its own blur radius, so the whole feather lands outside
     the text and 6.3's verified pairings hold by construction. */
  .hero__epigraph::before {
    content: "";
    position: absolute;
    inset: calc(var(--s-9) * -1);
    z-index: -1;
    pointer-events: none;
    background: var(--ink);
    filter: blur(var(--s-7));
  }

  /* Quiet. The Arabic carries it; the English and the reference sit beside
     it rather than stacking into a block that would read as a banner. */
  .hero__epigraph-ar {
    font-size: var(--fs-subtitle);
    line-height: var(--lh-arabic);
    color: var(--text-on-dark);
  }

  .hero__epigraph-en,
  .hero__epigraph-ref {
    color: var(--text-on-dark-soft);
  }

  .hero__inner {
    position: relative;
    z-index: var(--z-content);
    width: 100%;
  }

  .hero__grid {
    align-items: center;
    row-gap: var(--s-7);
  }

  .hero__type {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    color: var(--text-on-dark);
  }

  .hero__type .t-lead {
    color: var(--text-on-dark-soft);
  }

  /**
   * 14.1 puts the hero type block in five of ten columns and COPY.md fixes
   * the headline's three line breaks. Measured at 1440px, the longest of
   * those lines is 979px at --fs-hero's 160px and the block is 642px, so the
   * two cannot both hold. --fs-display is the next role down and lands the
   * same line at 636px: it fits, with the hero's own leading and tracking
   * intact. Both values are section 1 tokens; nothing is invented here.
   */
  .hero__headline {
    font-size: var(--fs-display);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-5) var(--s-6);
    margin-block-start: var(--s-2);
  }

  /* 13.2 - the Window's position, by breakpoint. */
  .hero__window {
    grid-column: 1 / -1;
    margin-block-start: var(--s-7);
  }

  @media (min-width: 768px) {
    .hero__window {
      grid-column: 4 / 11;
      margin-block-start: var(--s-8);
    }
  }

  @media (min-width: 1200px) {
    .hero__type {
      grid-column: 1 / 6;
      padding-block-end: var(--s-9);
    }

    /* 13.2 - the aperture occupies grid columns 6 through 11 and sits just
       below centre. Its width comes from the grid area rather than a
       percentage, so it stays exactly five columns at any container width. */
    .hero__window {
      grid-column: 6 / 11;
      align-self: center;
      margin-block-start: var(--s-6);
    }
  }

  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__cue {
    position: absolute;
    inset-block-end: var(--s-6);
    inset-inline-start: 50%;
    transform: translateX(-50%);
    z-index: var(--z-content);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-2);
    color: var(--text-on-dark-soft);
  }

  .hero__cue .t-label {
    color: var(--text-on-dark-soft);
  }

  @media (max-width: 599px) {
    .hero__cue {
      display: none;
    }
  }
</style>
