---
/**
 * DESIGN.md 14.1 section 5. Three stacked editorial blocks, NOT cards.
 *
 * Blocks 1 and 3 carry a photo in the right-hand column; block 2's photo
 * column is left empty so the rhythm breaks. That break is the composition -
 * it is what stops three pieces of content reading as a three-up grid, which
 * is banned in 4.1, 7.5 and 12.4.
 *
 * Copy from COPY.md, Home section 5.
 *
 * NOTE ON THE MEDIA SLOTS. 14.1 asks for a 4/5 photo on blocks 1 and 3, but
 * section 15 gives the homepage exactly one 4/5 slot (home.program.arabic).
 * Rather than invent a twenty-first slot, block 3 uses home.calendar.room at
 * its own declared 5/4 - the aspect ratio belongs to the slot, so a slot used
 * at its own ratio is never wrong, and the photo-empty-photo rhythm the
 * section depends on survives intact.
 */
import Media from '../Media.astro';
import Button from '../Button.astro';
import { labels } from '../../data/site';

const blocks = [
  {
    index: '01',
    title: 'Arabic',
    body: 'We teach children to read Arabic so that they can meet the Quran themselves. Recitation through the Noorani method, basic Quranic vocabulary, the shorter suras committed to memory, and a love for the Quran as a book of guidance.',
    slot: 'home.program.arabic',
  },
  {
    index: '02',
    title: 'Deen',
    body: 'Taught by theme rather than by textbook. A six-year-old and a sixteen-year-old spend the same Sunday on the same idea, each at the depth their age can hold.',
    slot: null,
  },
  {
    index: '03',
    title: '...and in between',
    body: "The school's own name for the part that is on no syllabus. The friendships. The question asked in a hallway. The habit of showing up on a Sunday when you could be anywhere else.",
    slot: 'home.calendar.room',
  },
];
---

<div class="brief">
  {
    blocks.map((block) => (
      <article class="brief__block grid">
        <p class="t-label brief__index" data-motion="body-rise">{block.index}</p>

        <div class="brief__text">
          <h3 class="t-title" data-motion="line-rise">{block.title}</h3>
          <p class="t-body" data-motion="body-rise">{block.body}</p>
        </div>

        {block.slot && (
          <div class="brief__media">
            <Media slotId={block.slot} sizes="(min-width: 1024px) 28vw, 90vw" />
          </div>
        )}
      </article>
    ))
  }

  <div class="brief__cta">
    <Button href="/program" variant="quiet" icon="arrow-right">{labels.program}</Button>
  </div>
</div>

<style>
  .brief {
    display: flex;
    flex-direction: column;
    gap: var(--s-9);
  }

  .brief__block {
    row-gap: var(--s-5);
    align-items: start;
  }

  .brief__index,
  .brief__text,
  .brief__media {
    grid-column: 1 / -1;
  }

  .brief__text {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    max-width: var(--measure);
  }

  @media (min-width: 1024px) {
    .brief__index { grid-column: 1 / 3; }
    .brief__text  { grid-column: 3 / 8; }
    .brief__media { grid-column: 8 / 11; }
  }

  .brief__cta {
    align-self: start;
  }
</style>
