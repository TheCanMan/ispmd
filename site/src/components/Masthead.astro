---
/**
 * DESIGN.md 13.3, "The masthead band".
 *
 * On every interior page the shader occupies a band, never the full page:
 * 52svh at >=768px, 44svh below, --ratio-band maximum. The page title sits
 * over it. Six of the eight bands are light; Give and Contact are dark.
 *
 * That is the site's rhythm: an overture on every page, a full-viewport hero
 * on exactly one.
 *
 *   <Masthead preset="story" label="ABOUT THE SCHOOL" lines={['More than', 'a Sunday school.']} />
 *
 * The canvas is aria-hidden and tabindex="-1". No information exists only in
 * it, and the CSS gradient behind it is a complete, good-looking fallback
 * rather than an apology.
 */
import type { PresetName } from '../scripts/webgl';

interface Props {
  preset: PresetName;
  label?: string;
  /** COPY.md breaks these lines deliberately. Break them exactly there. */
  lines: string[];
  /** Give and Contact. Puts the band on the dark side of 6.2. */
  dark?: boolean;
  /** The Calendar masthead is shorter than the others (14.4). */
  short?: boolean;
  class?: string;
}

const {
  preset,
  label,
  lines,
  dark = false,
  short = false,
  class: className = '',
} = Astro.props;
---

<section
  class:list={['shader-band', 'masthead', { 'on-dark': dark, 'masthead--short': short }, className]}
>
  <div class:list={['shader-band__fallback', `masthead__fallback--${preset}`]} aria-hidden="true"></div>

  <canvas
    class="shader-band__canvas"
    aria-hidden="true"
    tabindex="-1"
    data-field-canvas
    data-field-preset={preset}></canvas>

  <div class="shader-band__inner container">
    <div class="masthead__type grid">
      <div class="masthead__block">
        {label && <p class="t-label" data-motion="body-rise">{label}</p>}
        <h1 class="t-hero" data-motion="line-rise">
          {lines.map((line, i) => (
            <>
              {i > 0 && (
                <>
                  {' '}
                  <br />
                </>
              )}
              {line}
            </>
          ))}
        </h1>
      </div>
      <slot />
    </div>
  </div>
</section>

<script>
  /**
   * Three.js is dynamically imported, so a page that never scrolls its band
   * into view on a slow connection never pays for it.
   */
  import { mountField, registerField, type PresetName } from '../scripts/webgl';

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-field-canvas]')) {
    const preset = canvas.dataset.fieldPreset as PresetName | undefined;
    if (!preset) continue;

    mountField(canvas, {
      preset,
      onFallback: () => canvas.classList.remove('is-live'),
    })
      .then((handle) => {
        /* Publish the handle so page code can scrub its uniforms - 13.3's
           rising light on /give and 13.4's loosening density on /program are
           specified motion, and they cannot be written from inside here. */
        if (handle) registerField(preset, handle);
      })
      .catch(() => {
        /* Leave the gradient. A masthead that fails to compile a shader is a
           page with a slightly plainer band, not a broken page. */
        canvas.classList.remove('is-live');
      });
  }
</script>

<style>
  .masthead {
    /* 4.2 - the masthead is the page's first section and carries its own
       rhythm rather than a --section-y on top of the band height. */
    margin-block-end: 0;
  }

  .masthead--short {
    min-height: 44svh;
  }

  .masthead__type {
    align-items: end;
  }

  /*
   * The eyebrow uses the SOFT token, not the faint one. 6.2 assigns --*-faint
   * to meta labels on a solid ground; over the masthead's semi-transparent
   * scrim a 13px faint label measured 3.88-4.34:1 on /contact, /give and
   * /enroll. Soft clears it on every masthead with margin.
   */
  .masthead .t-label {
    color: var(--ctx-text-soft);
  }

  .masthead__block {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  /*
   * The same defect as the hero, five pages over. A masthead band is either a
   * light field or a photograph, and neither is dark enough or light enough
   * anywhere in particular - measured over the shader, --text-on-dark landed
   * at 1.10:1 on /give and --text at 2.17:1 on /our-story.
   *
   * The scrim resolves to the exact ground each colour was VERIFIED against in
   * 6.3: --paper under dark type, --ink under cream type. That makes the whole
   * of 6.3 hold by construction rather than by whatever the field happens to
   * be doing at that pixel, and it works identically over a shader and over a
   * photograph because it never looks at what is behind it.
   *
   * It is applied to every direct child of .masthead__type, not just the
   * headline block, so anything a page slots into a masthead is covered too.
   * A solid inset to twice its own blur radius keeps the core at full ground
   * across the element and puts the entire feather outside the text.
   */
  /* :global on the CHILD, not the parent. Astro compiles `.masthead__type > *`
     into `.masthead__type[cid] > [cid]`, and slotted content carries the
     PAGE's cid, so the rule silently skipped exactly the elements it was
     written for - the /program epigraph and the /give sub-line. Scoping the
     parent and globalising the child keeps it to this component's mastheads. */
  /*
   * SCRIM REACH IS A GEOMETRY PROBLEM, not a stacking one.
   *
   * Each block's scrim is a solid inset behind its own text. When it reached
   * 272px beyond its block (inset 176 + blur 96) and the gap to the next block
   * is 45px, it necessarily covered the neighbour's text - which is why
   * "$60 tuition." painted at 5.18:1 while "A school with" painted at 14.45:1
   * on the same headline.
   *
   * No z-index arrangement fixes that. Two overlapping scrims and two blocks
   * of text: whichever order they paint in, one scrim lands on one text. And
   * the children cannot be relied on to stay out of their own stacking
   * context - GSAP leaves a transform on anything with data-motion, which
   * makes one whether you asked for it or not.
   *
   * So the reach is BOUNDED instead - wide enough that two neighbouring
   * scrims meet at full strength, narrow enough that neither reaches the
   * other's glyphs. Measured gaps between masthead blocks are 45px (/give),
   * 53px (/calendar) and 60px (/program); the geometry below is solved
   * against the tightest of those.
   */
  .masthead__type > :global(*) {
    position: relative;
  }

  .masthead__type > :global(*:not(:empty))::before {
    content: "";
    position: absolute;
    /*
     * 36px inset against a 12px blur: the SOLID core reaches 24px beyond the
     * block and the feather dies at 48px.
     *
     * Both numbers are set by the junction, not by taste. At 24/16 the core
     * reached only 8px out, so across the 45px gap on /give the two scrims
     * met as feather-against-feather and composited to well under their own
     * 0.88 - a measured luminance spike from 0.037 to 0.0995, visible as a
     * lighter bar straight across the slab. Two cores reaching 24px close
     * that 45px gap with 3px to spare.
     *
     * The feather still has to stop short of the NEIGHBOUR's glyphs, because
     * a scrim inside a GSAP-transformed sibling paints above them rather than
     * behind. 48px lands 3px inside the next block's box, ahead of its own
     * ~8px of leading, so it reaches padding and never a glyph.
     */
    inset: -36px;
    z-index: -1;
    pointer-events: none;
    /* Semi-transparent and softly blurred rather than an opaque slab: at full
       ink with a 12px edge this read as a black box laid over the band. The
       field still shows through; the measured worst glyph is what matters and
       it clears 4.5 with room to spare. */
    background: rgba(248, 250, 247, 0.88);   /* --paper */
    filter: blur(12px);
  }

  .masthead.on-dark .masthead__type > :global(*:not(:empty))::before {
    background: rgba(20, 38, 28, 0.88);      /* --ink */
  }

  @media (min-width: 1024px) {
    .masthead__block {
      grid-column: 1 / 8;
    }
  }

  /**
   * Tier 3, and the ground the shader paints over on tiers 1 and 2.
   * Layered radial gradients in the preset's own three palette stops, so the
   * page looks composed even with no WebGL at all.
   */
  .shader-band__fallback {
    background-color: var(--paper);
  }

  .masthead__fallback--story {
    background:
      radial-gradient(120% 90% at 22% 30%, var(--fill-sky) 0%, transparent 62%),
      linear-gradient(160deg, var(--paper) 0%, var(--paper-warm) 100%);
  }
  .masthead__fallback--program {
    background:
      radial-gradient(120% 90% at 50% 18%, var(--sienna) 0%, transparent 58%),
      linear-gradient(160deg, var(--paper-warm) 0%, var(--fill-apricot) 100%);
  }
  .masthead__fallback--calendar {
    background:
      radial-gradient(120% 90% at 78% 22%, var(--slate) 0%, transparent 58%),
      linear-gradient(160deg, var(--paper-cool) 0%, var(--fill-sky) 100%);
  }
  .masthead__fallback--enroll {
    background:
      radial-gradient(120% 90% at 30% 55%, var(--sienna) 0%, transparent 58%),
      linear-gradient(160deg, var(--paper) 0%, var(--fill-apricot) 100%);
  }
  .masthead__fallback--faqs {
    background:
      radial-gradient(120% 90% at 50% 10%, var(--paper-warm) 0%, transparent 62%),
      linear-gradient(160deg, var(--paper) 0%, var(--paper-cool) 100%);
  }
  .masthead__fallback--give {
    background:
      radial-gradient(140% 100% at 50% 100%, var(--sienna) 0%, var(--slate) 45%, transparent 78%),
      linear-gradient(180deg, var(--ink) 0%, var(--ink) 100%);
  }
  .masthead__fallback--contact {
    background:
      radial-gradient(120% 90% at 50% 62%, var(--fill-sky) 0%, transparent 58%),
      linear-gradient(160deg, var(--slate-deep) 0%, var(--slate) 100%);
  }
  .masthead__fallback--notfound {
    background:
      radial-gradient(120% 90% at 50% 50%, var(--fill-apricot) 0%, transparent 58%),
      linear-gradient(160deg, var(--paper) 0%, var(--sienna) 100%);
  }
</style>
