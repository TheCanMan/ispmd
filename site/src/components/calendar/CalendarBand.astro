---
/**
 * DESIGN.md 13.4, "The Year". Thirty-three Sundays as one continuous band.
 *
 * On the Calendar page it wraps into a grid below 1024px. On the homepage it
 * is a horizontally scrollable strip with an edge fade and a visible
 * affordance - the one element on this site permitted to scroll sideways
 * (10, "Zoom"), and it does so deliberately.
 *
 * The band renders statically with every session in it. The next-class
 * highlight is progressive enhancement layered on top by the island, so a
 * visitor with a wrong clock gets a wrong highlight over a correct list.
 */
import CalendarCell from './CalendarCell.astro';
import CalendarLegend from './CalendarLegend.astro';
import type { Session } from '../../data/calendar';

interface Props {
  sessions: Session[];
  /** 'strip' scrolls sideways (homepage); 'grid' wraps (calendar page). */
  variant?: 'strip' | 'grid';
  /** COPY.md: `SCROLL THE YEAR`, homepage version only. */
  affordance?: string;
  legend?: boolean;
  class?: string;
}

const {
  sessions,
  variant = 'grid',
  affordance,
  legend = true,
  class: className = '',
} = Astro.props;

/* Derived from the data rather than hardcoded, so the accessible name cannot
   drift from the year actually rendered. */
const first = sessions[0]?.date.slice(0, 4);
const last = sessions[sessions.length - 1]?.date.slice(0, 4);
const yearLabel = first && last && first !== last ? `${first}-${last}` : (first ?? '');
const regionLabel = `The ${yearLabel} school year, Sunday by Sunday`;
---

<div class={`cal-band cal-band--${variant} ${className}`} data-calendar-band>
  {legend && <CalendarLegend class="cal-band__legend" />}

  {/*
    10 - a region that scrolls has to be reachable by keyboard, or a parent who
    cannot use a mouse cannot read the second half of the year at all. The strip
    variant scrolls, so it is focusable in the markup and works with no JS; the
    script below then keeps that true of whichever bands ACTUALLY overflow at
    the current width, rather than trusting the variant name.

    The outline lives on the viewport wrapper because the scroller carries the
    edge-fade mask, and a mask clips the element's own outline along with its
    content.
  */}
  <div class="cal-band__viewport">
    <div
      class="cal-band__scroller"
      role="region"
      aria-label={regionLabel}
      tabindex={variant === 'strip' ? 0 : undefined}
      data-calendar-scroller
    >
      <div class="cal-band__cells" data-stagger-vector>
        {sessions.map((session) => <CalendarCell session={session} />)}
      </div>
    </div>
  </div>

  {affordance && <p class="t-label cal-band__affordance">{affordance}</p>}
</div>

<script>
  /**
   * Focusable exactly when scrollable, at any width and on any page. Tying it
   * to the variant would be a guess about layout; measuring the overflow is
   * not, and it means a band that starts scrolling at some breakpoint is
   * reachable there too.
   */
  const sync = () => {
    for (const el of document.querySelectorAll<HTMLElement>('[data-calendar-scroller]')) {
      const scrolls = el.scrollWidth - el.clientWidth > 1;
      if (scrolls) {
        el.setAttribute('tabindex', '0');
      } else if (el !== document.activeElement) {
        el.removeAttribute('tabindex');
      }
    }
  };

  sync();
  window.addEventListener('resize', sync, { passive: true });
  document.fonts?.ready.then(sync);
</script>

<style>
  .cal-band {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  .cal-band__viewport {
    position: relative;
  }

  .cal-band__viewport:has(.cal-band__scroller:focus-visible) {
    outline: var(--focus-width) solid var(--ctx-focus);
    outline-offset: var(--focus-offset);
  }

  .cal-band__scroller {
    position: relative;
  }

  .cal-band__scroller:focus-visible {
    /* The wrapper draws the ring; drawing it twice reads as a doubled border. */
    outline: none;
  }

  .cal-band__cells {
    display: grid;
    gap: var(--s-3);
  }

  /* ---- grid variant: the Calendar page ---- */

  /*
   * The column count is chosen by the available width, not fixed. Eleven
   * columns divided 33 cells into exactly three rows, which was elegant and
   * unreadable: a 108px cell leaves 76px of content, and "Thanksgiving" broke
   * to "Thanksgi / ving", "Deen Showcase" to "Showcas / e".
   *
   * A minimum cell width states the actual constraint - a title has to fit -
   * and lets the browser pick the count at every breakpoint, instead of a
   * magic number that only worked at one.
   */
  .cal-band--grid .cal-band__cells {
    grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
  }

  @media (max-width: 599px) {
    .cal-band--grid .cal-band__cells {
      grid-template-columns: repeat(auto-fill, minmax(128px, 1fr));
    }
  }

  /* ---- strip variant: the homepage ---- */

  .cal-band--strip .cal-band__scroller {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    padding-block-end: var(--s-3);
    /* The edge fade is a mask so it works over any ground colour. */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      var(--ink) 24px,
      var(--ink) calc(100% - 48px),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      var(--ink) 24px,
      var(--ink) calc(100% - 48px),
      transparent 100%
    );
  }

  .cal-band--strip .cal-band__cells {
    grid-auto-flow: column;
    grid-auto-columns: 148px;
    grid-template-columns: none;
  }

  .cal-band--strip .cal-band__cells > :global(.cal-cell) {
    scroll-snap-align: start;
    aspect-ratio: 1 / 1;
  }

  .cal-band__affordance {
    align-self: flex-end;
  }

  @media print {
    .cal-band--strip .cal-band__scroller {
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>
