---
/**
 * DESIGN.md 4.3. The site's smallest expression of the concept, and it
 * replaces every horizontal rule.
 *
 * A 1px rule runs the full container width. At its left end, over the first
 * 140px, the line resolves into three cells of the girih lattice - the
 * strapwork briefly becomes visible, then relaxes back into a plain hairline.
 *
 * The lattice detail ships at its own size rather than inside a 1000-wide
 * viewBox stretched to 100%: a single SVG scaled non-uniformly would distort
 * the geometry, and the geometry is the whole point.
 *
 * On scroll into view the lattice draws left to right and the rule scales
 * from scaleX(0) with origin left. Both are driven by motion.ts.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`divider ${className}`} aria-hidden="true" data-divider>
  <svg
    class="divider__lattice"
    viewBox="0 0 140 40"
    width="140"
    height="40"
    fill="none"
    stroke="currentColor"
    stroke-width="1"
    stroke-linejoin="miter"
    stroke-miterlimit="10"
    stroke-linecap="butt"
    focusable="false"
  >
    <path data-divider-strap d="M42.06,20 L14.53,40 L4.02,7.64 L38.04,7.64 L27.53,40 L0,20 L27.53,0 L38.04,32.36 L4.02,32.36 L14.53,0 Z" />
    <path data-divider-strap d="M84.12,20 L56.59,40 L46.07,7.64 L80.1,7.64 L69.59,40 L42.06,20 L69.59,0 L80.1,32.36 L46.07,32.36 L56.59,0 Z" />
    <path data-divider-strap d="M126.18,20 L98.65,40 L88.13,7.64 L122.16,7.64 L111.64,40 L84.12,20 L111.64,0 L122.16,32.36 L88.13,32.36 L98.65,0 Z" />
  </svg>
  <span class="divider__rule" data-divider-rule></span>
</div>
